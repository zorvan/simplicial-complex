{
  "name": "simplicial-complex",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "description": "simplicial complex visualization with topological analysis",
  "scripts": {
    "build": "node build.mjs production",
    "build:dev": "node build.mjs development",
    "check": "./node_modules/typescript/bin/tsc --noEmit",
    "test": "./node_modules/typescript/bin/tsc -p tsconfig.tests.json && node --test tests-dist/tests/*.test.js",
    "benchmark:hypergraph": "./node_modules/typescript/bin/tsc -p tsconfig.tests.json && node scripts/hypergraph-benchmark.mjs",
    "benchmark:topology": "./node_modules/typescript/bin/tsc -p tsconfig.tests.json && node scripts/topology-benchmark.mjs",
    "lint": "eslint .",
    "check:publisher": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs",
    "ci:act": "act push --workflows .github/workflows/ci.yml --pull=false",
    "ci:act:list": "act push --workflows .github/workflows/ci.yml --list"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "eslint-plugin-obsidianmd": "^0.2.4",
    "obsidian": "^1.12.3",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "tsc": "^2.0.4"
  }
}
